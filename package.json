{
  "name": "smart-vocab",
  "version": "0.5.7",
  "private": true,
  "description": "智能单词本 0.5.7 beta — 内置六级 4036 词 + 核心感觉 + 词根演变 + 近义辨析",
  "main": "main.js",
  "author": "Mokiklok",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "portable": "node scripts/package-portable.mjs",
    "test:builtin": "node scripts/test-builtin-library.cjs",
    "test:update-safety": "node scripts/test-update-safety.cjs",
    "test:study": "node scripts/test-study-log.cjs",
    "test:performance": "node scripts/test-performance.cjs",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mokiklok.smartvocab",
    "productName": "SmartVocab",
    "copyright": "Copyright © 2026 Mokiklok",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "lib/**/*",
      "data-cet6.json.gz",
      "data-cet6.manifest.json",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SmartVocab-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1436805877",
        "repo": "smart-vocab-bydpsk",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "智能单词本",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "SmartVocab-${version}-portable.exe"
    }
  }
}
