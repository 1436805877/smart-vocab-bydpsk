{
  "name": "smart-vocab",
  "version": "0.2.0",
  "private": true,
  "description": "智能单词本 0.1 beta — 核心感觉 + 词根演变 + 近义辨析",
  "main": "main.js",
  "author": "Mokiklok",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "portable": "node scripts/package-portable.mjs",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mokiklok.smartvocab",
    "productName": "SmartVocab",
    "copyright": "Copyright © 2026 Mokiklok",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SmartVocab-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "智能单词本",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "SmartVocab-${version}-portable.exe"
    }
  }
}
